[Unit]
Description=WEB Proxy: MTProxy shard %i
After=network-online.target wpp-firewall.service
Wants=network-online.target wpp-firewall.service
# Wants, not Requires: an nftables restart re-applies the table through
# wpp-firewall (PartOf=nftables.service) without restarting this service.

[Service]
Type=simple
User=webproxy
Group=webproxy
# Generated by webproxy (pool.render_shard_env): 16 secrets and ports of this shard.
EnvironmentFile=/etc/webproxy/shards/%i.env
WorkingDirectory=/var/lib/webproxy/mtproxy
# -M 0: one process (8 MiB RSS instead of 15 MiB with -M 1, FINDINGS item 8).
# --http-stats opens the -p stats port, answered only for 127.0.0.1 (FINDINGS item 1).
# $WPP_SECRET_ARGS and $WPP_NAT_ARGS are unquoted so they split into words.
ExecStart=/opt/webproxy/bin/mtproto-proxy -p ${WPP_STATS_PORT} --http-stats -H ${WPP_PORTS} $WPP_SECRET_ARGS $WPP_NAT_ARGS --aes-pwd /var/lib/webproxy/mtproxy/proxy-secret /var/lib/webproxy/mtproxy/proxy-multi.conf -M 0 -C ${WPP_MAX_CONNECTIONS}
Restart=on-failure
RestartSec=3s
LimitNOFILE=1048576
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectProc=invisible
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadOnlyPaths=/var/lib/webproxy/mtproxy
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Middle-end addresses come from proxy-multi.conf and change: no IPAddressDeny (FINDINGS item 13).

[Install]
WantedBy=multi-user.target
