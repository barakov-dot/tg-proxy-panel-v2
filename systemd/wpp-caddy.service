[Unit]
Description=WEB Proxy: Caddy HTTPS front
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=webproxy
Group=webproxy
Environment=HOME=/var/lib/webproxy/caddy
Environment=XDG_DATA_HOME=/var/lib/webproxy/caddy
Environment=XDG_CONFIG_HOME=/var/lib/webproxy/caddy
# WPP_DOMAIN, WPP_PANEL_PATH, ACME_EMAIL.
EnvironmentFile=/etc/webproxy/caddy.env
# No --environ: it would print WPP_PANEL_PATH to the journal.
ExecStart=/opt/webproxy/bin/caddy run --config /etc/webproxy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadWritePaths=/var/lib/webproxy/caddy
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
